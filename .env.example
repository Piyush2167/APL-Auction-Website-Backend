NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (Atlas is a replica set, required for transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/apl_auction?retryWrites=true&w=majority
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
TEMP_PASSWORD_HOURS=48
# Public URL of the frontend (used in emails) and default CORS origin
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra origins
CORS_ORIGINS=
# SMTP. Without it: dev writes emails to backend/.mail/, production cannot send
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=APL Auction <no-reply@example.com>
# Optional image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
