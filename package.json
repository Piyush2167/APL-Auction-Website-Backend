{
  "name": "apl-auction-backend",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 tests/*.test.js",
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "sync-indexes": "node -e \"require('./src/config/env');const {connectDB}=require('./src/config/db');const M=require('./src/models');connectDB(process.env.MONGODB_URI).then(()=>Promise.all(Object.values(M).map(x=>x.syncIndexes()))).then(()=>console.log('indexes synced')).finally(()=>require('mongoose').disconnect())\"",
    "dev-db": "node scripts/dev-db.js"
  },
  "license": "ISC",
  "description": "",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
